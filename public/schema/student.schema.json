{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/schema/student.schema.json",
  "title": "Student",
  "description": "One student record of the CST463 Laravel Lab",
  "type": "object",
  "properties": {
    "roll_no":  { "type": "string", "pattern": "^CS[0-9]{2}-[0-9]{2}$" },
    "name":     { "type": "string", "minLength": 3 },
    "email":    { "type": "string", "format": "email" },
    "department": { "type": "string", "enum": ["CSE", "ECE", "EEE", "ME", "CE"] },
    "semester": { "type": "integer", "minimum": 1, "maximum": 8 },
    "cgpa":     { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
    "subjects": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  },
  "required": ["roll_no", "name", "email", "semester"],
  "additionalProperties": false
}
